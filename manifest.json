{
  "manifest_version": 3,
  "name": "Shop.app Receipt Exporter",
  "version": "1.2.1",
  "description": "Preview, print, and export Shop.app receipt details.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://shop.app/*"
  ],
  "action": {
    "default_title": "Preview Receipt Export"
  },
  "background": {
    "service_worker": "background.js"
  }
}

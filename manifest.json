{
  "manifest_version": 3,
  "name": "Shop.app Receipt Exporter",
  "version": "1.0.0",
  "description": "Export Shop.app order line items directly to CSV.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://shop.app/*"
  ],
  "action": {
    "default_title": "Export Receipt to CSV"
  },
  "background": {
    "service_worker": "background.js"
  }
}
